# Local development: copy this file to .streamlit/secrets.toml and fill in your project values.
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "YOUR_SUPABASE_PUBLISHABLE_KEY"
APP_URL = "http://localhost:8501"

# Optional: set this if invitation links should open a different public URL.
# PUBLIC_APP_URL = "https://uniarena.streamlit.app"

# Optional: enable Google Calendar with the credentials for your OAuth client.
# GOOGLE_CLIENT_ID = "YOUR_GOOGLE_CLIENT_ID"
# GOOGLE_CLIENT_SECRET = "YOUR_GOOGLE_CLIENT_SECRET"
